        <item>
            <title>1.0.18</title>
            <pubDate>Fri, 23 Oct 2026 15:11:33 +0000</pubDate>
            <sparkle:version>22</sparkle:version>
            <sparkle:shortVersionString>1.0.18</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <enclosure url="https://github.com/fabioov/ConnexGUI-updates/releases/download/v1.0.18/ConnexGUI-1.0.18.dmg" length="22826160" type="application/octet-stream" sparkle:edSignature="vaZz1oo3TCoFdp6FF7rSuq0nRacMjY2a45if3HD26LjYPXNp13boKVOcSziLsgxMg2i3mFyLw4BQbTN9kOK0Cw==" />
            <description>&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-type, straight to the point&lt;/b&gt;&lt;span&gt;When it opens, auto-type shows only your recent items and the space you&amp;#x27;re working on. Type to find the rest.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Also improved&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Secrets and variables now have different icons in auto-type.&lt;/li&gt;&lt;li&gt;What&amp;#x27;s new now appears in the update dialog, right when you install a new version.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="en">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-type, straight to the point&lt;/b&gt;&lt;span&gt;When it opens, auto-type shows only your recent items and the space you&amp;#x27;re working on. Type to find the rest.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Also improved&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Secrets and variables now have different icons in auto-type.&lt;/li&gt;&lt;li&gt;What&amp;#x27;s new now appears in the update dialog, right when you install a new version.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="pt">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-type direto ao ponto&lt;/b&gt;&lt;span&gt;Ao abrir, o auto-type mostra só os itens recentes e o espaço em que você está trabalhando. Digite para achar o resto.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Também melhorou&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Secrets e variables agora têm ícones diferentes no auto-type.&lt;/li&gt;&lt;li&gt;As novidades agora aparecem no diálogo de atualização, na hora de instalar a nova versão.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="es">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-type directo al grano&lt;/b&gt;&lt;span&gt;Al abrirse, el auto-type muestra solo tus elementos recientes y el espacio en el que trabajas. Escribe para encontrar el resto.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;También mejoró&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Los secrets y las variables ahora tienen iconos distintos en el auto-type.&lt;/li&gt;&lt;li&gt;Las novedades ahora aparecen en el diálogo de actualización, justo al instalar la nueva versión.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="de">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-Type auf den Punkt&lt;/b&gt;&lt;span&gt;Beim Öffnen zeigt Auto-Type nur deine letzten Elemente und den Space, an dem du arbeitest. Tippe, um den Rest zu finden.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Außerdem verbessert&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Secrets und Variablen haben im Auto-Type jetzt unterschiedliche Symbole.&lt;/li&gt;&lt;li&gt;Die Neuigkeiten erscheinen jetzt im Update-Dialog, direkt beim Installieren der neuen Version.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="fr">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Auto-type droit au but&lt;/b&gt;&lt;span&gt;À l&amp;#x27;ouverture, l&amp;#x27;auto-type n&amp;#x27;affiche que vos éléments récents et l&amp;#x27;espace sur lequel vous travaillez. Tapez pour trouver le reste.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Autres améliorations&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Les secrets et les variables ont maintenant des icônes différentes dans l&amp;#x27;auto-type.&lt;/li&gt;&lt;li&gt;Les nouveautés s&amp;#x27;affichent désormais dans la fenêtre de mise à jour, au moment d&amp;#x27;installer la nouvelle version.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="hi">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;ऑटो-टाइप, सीधा मुद्दे पर&lt;/b&gt;&lt;span&gt;खुलते समय ऑटो-टाइप सिर्फ़ आपके हाल के आइटम और वह स्पेस दिखाता है जिस पर आप काम कर रहे हैं। बाकी खोजने के लिए टाइप करें।&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;इनमें भी सुधार&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;ऑटो-टाइप में सीक्रेट और वेरिएबल के आइकन अब अलग-अलग हैं।&lt;/li&gt;&lt;li&gt;नया क्या है अब अपडेट डायलॉग में दिखता है, नया वर्ज़न इंस्टॉल करते समय।&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
        </item>
