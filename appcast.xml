            <description xml:lang="en">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Fuller Recent list&lt;/b&gt;&lt;span&gt;Items you use from Working on now also show up in Recent, at the top.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Also improved&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Recent items you used in auto-type are easier to find again.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="pt">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Recentes mais completos&lt;/b&gt;&lt;span&gt;Os itens que você usa em Working on agora também aparecem em Recentes, no topo.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Também melhorou&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Itens usados no auto-type ficam mais fáceis de achar de novo.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="es">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Recientes más completos&lt;/b&gt;&lt;span&gt;Los elementos que usas en Working on ahora también aparecen en Recientes, arriba.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;También mejoró&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Los elementos usados en el auto-type son más fáciles de volver a encontrar.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="de">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Vollständigere Zuletzt-Liste&lt;/b&gt;&lt;span&gt;Elemente, die du aus Working on nutzt, erscheinen jetzt auch unter Zuletzt, ganz oben.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Außerdem verbessert&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Im Auto-Type genutzte Elemente lassen sich leichter wiederfinden.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="fr">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;Récents plus complets&lt;/b&gt;&lt;span&gt;Les éléments que vous utilisez dans Working on apparaissent aussi dans Récents, en haut.&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;Autres améliorations&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Les éléments utilisés dans l&amp;#x27;auto-type sont plus faciles à retrouver.&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <description xml:lang="hi">&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset='utf-8'&gt;&lt;meta name='color-scheme' content='light dark'&gt;&lt;style&gt;body{font:13px -apple-system,system-ui,sans-serif;margin:14px 16px;line-height:1.4}h2{font-size:12px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;margin:18px 0 6px}.h{margin:0 0 12px}.h b{display:block;font-size:14px}.h span{opacity:.75}ul{margin:0;padding-left:18px}li{margin:3px 0}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class='h'&gt;&lt;b&gt;ज़्यादा पूरे हाल के आइटम&lt;/b&gt;&lt;span&gt;Working on से इस्तेमाल किए गए आइटम अब हाल के आइटम में भी सबसे ऊपर दिखते हैं।&lt;/span&gt;&lt;/div&gt;&lt;h2&gt;इनमें भी सुधार&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;ऑटो-टाइप में इस्तेमाल किए गए आइटम दोबारा ढूँढना आसान है।&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</description>
